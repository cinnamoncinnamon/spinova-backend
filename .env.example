# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.

# Server
PORT=4000
NODE_ENV=development

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://spinova:spinova_dev_password@localhost:5432/spinova

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# JWT secrets - generate strong random values for real use
# (e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string

# Admin login (username + password hash, not a static shared key).
# Generate the hash with: node generate_admin_password.mjs YourChosenPassword
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_from_generate_admin_password_script
# Random secret for signing admin session JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=replace_this_with_a_long_random_string

# Frontend origins allowed to call this API (rx8 player app + spinova-admin).
# Set both to your real deployed URLs in production, e.g.:
# CORS_ORIGIN_1=https://play.yourdomain.com
# CORS_ORIGIN_2=https://admin.yourdomain.com
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://localhost:5174

# Telegram alerts (optional — big win / risk notifications to admin chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Minimum win amount (in BDT) that triggers a "big win" Telegram alert
BIG_WIN_THRESHOLD=5000
